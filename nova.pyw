                return sorted(int(pid) for pid in _udp_listen_pids_for_port(self.port))
            except:
                return []

        def _adopt_listener_if_ready(self):
            try:
                listener_pids = self._listener_pids()
                if not listener_pids:
                    return False
                chosen_pid = None
