            self.process = None
            self._adopted_pid_logged = False
            self._start_lock = threading.Lock()
            self.script_path = get_internal_path(os.path.join("NovaWFP", "proxy", "udp_proxy.py"))
            self.host = "0.0.0.0"
            self.port = 17871

