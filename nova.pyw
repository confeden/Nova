    def ip_in_network(ip, net):
        """IP/CIDR match helper with IPv4+IPv6 support."""
        try:
            import ipaddress
            ip_s = str(ip).strip()
            if "%" in ip_s:
                ip_s = ip_s.split("%", 1)[0]
            net_s = str(net).strip()
            if "/" not in net_s:
                net_s = f"{net_s}/128" if ":" in net_s else f"{net_s}/32"
            ip_obj = ipaddress.ip_address(ip_s)
            net_obj = ipaddress.ip_network(net_s, strict=False)
            if ip_obj.version != net_obj.version:
                return False
            return ip_obj in net_obj
        except:
            return False

    WINWS_LOCAL_IPV4_BYPASS_CIDRS = (
        "0.0.0.0/8",
        "10.0.0.0/8",
        "100.64.0.0/10",
        "127.0.0.0/8",
        "169.254.0.0/16",
        "172.16.0.0/12",
        "192.0.0.0/24",
        "192.0.2.0/24",
        "192.168.0.0/16",
        "198.18.0.0/15",
        "198.51.100.0/24",
        "203.0.113.0/24",
        "224.0.0.0/4",
        "240.0.0.0/4",
    )

    def _winws_ipv4_not_in_net_clause(cidr):
        try:
            import ipaddress
            net = ipaddress.ip_network(str(cidr), strict=False)
            if net.version != 4:
                return ""
            # WinDivert filter language accepts IPv4 literals but not CIDR
            # literals in comparisons, so render CIDR exclusion as a range.
            return f"(ip.DstAddr < {net.network_address} or ip.DstAddr > {net.broadcast_address})"
        except:
            return ""

    def get_loopback_bypass_clause():
        """
        Extra guard for local/private traffic.
        Nova must never apply WinWS strategies to local IPC/LAN traffic. Keep this
        enabled by default; strict WinWS fallback below can strip it if a build
        rejects the raw filter syntax.
        """
        try:
            enabled = str(os.environ.get("NOVA_WINWS_LOOPBACK_BYPASS", "1")).strip().lower() in ("1", "true", "yes", "on")
        except:
            enabled = True
        if not enabled:
            return ""
        try:
            use_ipv6 = str(os.environ.get("NOVA_WINWS_LOOPBACK_BYPASS_IPV6", "0")).strip().lower() in ("1", "true", "yes", "on")
        except:
            use_ipv6 = False
        ipv4_clauses = [
            clause for clause in (_winws_ipv4_not_in_net_clause(cidr) for cidr in WINWS_LOCAL_IPV4_BYPASS_CIDRS)
            if clause
        ]
        if not ipv4_clauses:
            ipv4_clauses = ["(ip.DstAddr < 127.0.0.0 or ip.DstAddr > 127.255.255.255)"]
        clause = " and " + " and ".join(ipv4_clauses)
        if use_ipv6:
            clause += " and !(ipv6.DstAddr == ::1)"
        return clause

    def is_warp_ip(ip):
        try:
            warp_ip_path = os.path.join(get_base_dir(), "ip", "warp.txt")
            if not os.path.exists(warp_ip_path): return False

            # Lightweight file cache to avoid reparsing 2k+ CIDRs on every lookup.
            try:
                cache_mtime = float(getattr(is_warp_ip, "_cache_mtime", 0.0))
                now_mtime = os.path.getmtime(warp_ip_path)
            except:
                cache_mtime = 0.0
                now_mtime = 0.0

            networks = getattr(is_warp_ip, "_cache_networks", None)
            if networks is None or cache_mtime != now_mtime:
                parsed = []
                try:
                    with open(warp_ip_path, "r", encoding="utf-8", errors="ignore") as f:
                        for line in f:
                            raw = line.split("#")[0].strip()
                            if not raw:
                                continue
                            if "/" not in raw:
                                raw = f"{raw}/128" if ":" in raw else f"{raw}/32"
                            parsed.append(raw)
                except:
                    parsed = []
                networks = parsed
                is_warp_ip._cache_networks = networks
                is_warp_ip._cache_mtime = now_mtime

            for net in networks:
                if ip_in_network(ip, net):
                    return True
        except: pass
        return False

