            def _refresh_group_pills(group_key):
                selected_mode = current_modes.get(group_key, DEFAULT_ROUTING_SETTINGS["routes"].get(group_key, "auto"))
                for mode_key, btn in pills_by_group.get(group_key, {}).items():
