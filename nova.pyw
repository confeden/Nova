    def is_local_http_proxy_responsive(port, timeout=0.9):
        """
        Low-impact local proxy probe.
        It validates that proxy listener parses HTTP locally without forcing upstream tunnel dials.
        """
        try:
            import socket
            with socket.create_connection(("127.0.0.1", int(port)), timeout=timeout) as s:
                s.settimeout(timeout)
                req = (
                    "OPTIONS * HTTP/1.1\r\n"
                    "Host: 127.0.0.1\r\n"
                    "Connection: close\r\n\r\n"
                ).encode("ascii", errors="ignore")
                s.sendall(req)
                data = s.recv(128) or b""
                if data.startswith(b"HTTP/"):
                    return True
        except:
            pass
        try:
            import socket
            with socket.create_connection(("127.0.0.1", int(port)), timeout=timeout) as s:
                s.settimeout(timeout)
                s.sendall(b"PING\r\n\r\n")
                data = s.recv(32) or b""
                return bool(data)
        except:
            return False

    def is_local_http_proxy_tunnel_ready(port, timeout=1.5, connect_hosts=None):
        """
        Strong proxy readiness probe.
        Requires both local parser responsiveness and at least one successful HTTP CONNECT tunnel.
        """
        if not is_local_http_proxy_responsive(port=port, timeout=min(float(timeout), 1.0)):
            return False
        # Use a single reliable host to maximize the time available for the proxy to respond
        hosts = list(connect_hosts or ("www.gstatic.com:443",))
        per_host_timeout = max(1.5, float(timeout) / max(1, len(hosts)))
        for connect_host in hosts:
            try:
                import socket
                with socket.create_connection(("127.0.0.1", int(port)), timeout=per_host_timeout) as s:
                    s.settimeout(per_host_timeout)
                    req = (
                        f"CONNECT {connect_host} HTTP/1.1\r\n"
                        f"Host: {connect_host}\r\n"
                        "Proxy-Connection: close\r\n\r\n"
                    ).encode("ascii", errors="ignore")
                    s.sendall(req)
                    data = s.recv(192) or b""
                    first_line = (data.splitlines() or [b""])[0].upper()
                    if first_line.startswith(b"HTTP/") and b" 200" in first_line:
                        return True
            except:
                continue
        return False

