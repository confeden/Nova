                            err_details = f"Error: {e}\nSrc: {sys.executable}\nDst: {target_dir}"
                            ctypes.windll.user32.MessageBoxW(0, f"Ошибка при перемещении:\n{err_details}", "Ошибка Nova", 0x10)
