                        if has_udp: proto_parts.append(f"(udp and udp.SrcPort >= {test_port} and udp.SrcPort <= {p_end}{loopback_bypass_clause})")
                        
                        isolation_filter = f"outbound and !loopback and ({' or '.join(proto_parts)})"
                        
