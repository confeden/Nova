                        proc = subprocess.Popen([exe_path] + test_args, cwd=get_base_dir(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, 
                                               creationflags=subprocess.CREATE_NO_WINDOW | 0x00004000)
